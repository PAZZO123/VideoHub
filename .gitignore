# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
build/
out/
*.tsbuildinfo

# env — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# test / coverage
coverage/
.nyc_output/

# editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# caches
.cache/
.turbo/
.eslintcache
vite.config.ts.timestamp-*

# local media scratch (never commit media)
# Anchored with a leading slash on purpose. A bare `storage/` or `uploads/`
# matches at ANY depth, which silently swallowed apps/api/src/storage and
# apps/api/src/uploads — the source modules, not the data — so neither was ever
# committed and a fresh clone could not build.
/apps/api/storage/
/storage/
/uploads/
tmp/
