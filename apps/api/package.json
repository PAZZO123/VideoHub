{
  "name": "@videohub/api",
  "version": "0.1.0",
  "private": true,
  "description": "VideoHub REST API (NestJS + Prisma + PostgreSQL/Neon)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:push": "dotenv -e ../../.env -- prisma db push",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/seed.ts",
    "prisma:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:verify": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/verify-constraints.ts",
    "db:seed:demo": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/seed-demo.ts",
    "db:verify:agegate": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/verify-age-gate.ts",
    "db:verify:trending": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/verify-trending.ts",
    "db:verify:all": "npm run db:clean:fixtures && npm run db:verify && npm run db:verify:agegate && npm run db:verify:trending && npm run db:verify:downloads && npm run db:verify:ai && npm run db:verify:admin",
    "db:verify:downloads": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/verify-downloads.ts",
    "db:verify:ai": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/verify-ai.ts",
    "db:verify:admin": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/verify-admin.ts",
    "db:clean:fixtures": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/clean-fixtures.ts",
    "db:sync:catalogue": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/sync-catalogue.ts",
    "db:sync:catalogue:ci": "ts-node -P tsconfig.seed.json prisma/sync-catalogue.ts",
    "db:make:admin": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/make-admin.ts",
    "db:make:admin:ci": "ts-node -P tsconfig.seed.json prisma/make-admin.ts",
    "prisma:generate:ci": "prisma generate",
    "prisma:deploy:ci": "prisma migrate deploy",
    "db:seed:ci": "ts-node -P tsconfig.seed.json prisma/seed.ts"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- ts-node -P tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^8.0.7",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.22.0",
    "@videohub/config": "0.1.0",
    "@videohub/types": "0.1.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.module.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
