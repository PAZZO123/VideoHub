# ---------------------------------------------------------------------------
# VideoHub — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_PREFIX=api
WEB_ORIGIN=http://localhost:5173

# --- Database (Neon PostgreSQL) --------------------------------------------
# Neon dashboard -> Connection Details -> "Pooled connection" (for the app).
# Must include `?sslmode=require`. Neon free tier is sufficient.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/videohub?sslmode=require"
# Neon "Direct connection" (unpooled) — required by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/videohub?sslmode=require"

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-use-a-48-byte-random-hex-string
JWT_REFRESH_SECRET=change-me-too-a-different-48-byte-random-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- AI provider -----------------------------------------------------------
# mock | claude | openai | gemini
# `mock` runs the full app with zero API cost and zero keys. Default for dev.
AI_PROVIDER=mock
AI_MAX_TOKENS=1024
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Movie metadata provider -----------------------------------------------
# local | tmdb   ("local" serves only your own DB — no external calls, no key)
MOVIE_METADATA_PROVIDER=local
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# --- Storage ---------------------------------------------------------------
# local | s3 | r2 | supabase
# `local` writes to STORAGE_LOCAL_DIR — development only, never production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_URL=http://localhost:3000/api/files
STORAGE_BUCKET=videohub
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MAX_UPLOAD_MB=2048

# --- External video catalogue ----------------------------------------------
# `archive` pulls real, playable public-domain video from the Internet Archive
# (no API key needed). `none` keeps the catalogue to your own uploads.
# Curated titles publish on sync; everything found by query lands in the
# moderation queue for a human to approve first.
VIDEO_CATALOGUE_PROVIDER=archive

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
# AI endpoints are limited separately so a public deploy can't run up API cost.
AI_RATE_LIMIT_TTL=60
AI_RATE_LIMIT_MAX=10

# --- Downloader policy -----------------------------------------------------
# Comma-separated hostnames the downloader is permitted to fetch from.
# VideoHub never bypasses DRM, auth, paywalls, or any technical protection;
# hosts not on this list return an "open original source" response instead.
DOWNLOAD_ALLOWED_HOSTS=archive.org,commons.wikimedia.org,upload.wikimedia.org,peertube.tv,cdn.videohub.local
DOWNLOAD_MAX_MB=1024

# --- Frontend (Vite — only VITE_* is exposed to the browser) ---------------
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=VideoHub
